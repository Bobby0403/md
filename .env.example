# 环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改配置

# ============================================
# iframe 安全配置
# ============================================

# iframe 允许的域名白名单（JSON 数组格式）
# 开发环境默认允许所有域名（*），生产环境默认不允许任何域名
# 
# 配置示例：
# - 精确匹配：["https://example.com"]
# - 通配符匹配：["https://*.example.com"] 允许所有子域名
# - 允许所有：["*"] （仅开发环境推荐）
# - 多个域名：["https://example.com", "https://app.example.com", "https://*.example.org"]
#
# 注意：
# 1. 生产环境必须配置此变量，否则编辑器将拒绝所有 iframe 通信
# 2. 建议只允许 HTTPS 域名
# 3. 使用通配符时注意安全风险
VITE_IFRAME_ALLOWED_ORIGINS=["*"]

# ============================================
# 其他配置
# ============================================

# VSCode 调试器启动编辑器（可选）
# VITE_LAUNCH_EDITOR=code
