# 开发环境配置示例
# 复制此文件为 .env.development 并根据实际情况修改配置

# ============================================
# iframe 安全配置
# ============================================

# 开发环境 iframe 允许的域名白名单
# 开发环境默认允许所有域名（*），但可以显式配置
# 
# 示例：允许本地开发服务器
VITE_IFRAME_ALLOWED_ORIGINS=["http://localhost:3000", "http://localhost:5173", "*"]

# ============================================
# 其他配置
# ============================================

# VSCode 调试器启动编辑器
VITE_LAUNCH_EDITOR=code
